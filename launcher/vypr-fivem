#!/usr/bin/env bash
#
# Launch FiveM from the Windows guest as a window on this desktop.
#
# Brings up whatever is not already up - the VM, the session daemon, the guest
# agent - and then starts the game. Safe to run when some or all of it is
# already running; each step is skipped if it is not needed.
set -uo pipefail

VM=RDPWindows
GUEST=192.168.122.58
KEY="$HOME/.ssh/vypr-guest"
SASH="$HOME/vypr/host/build"
SHM=/dev/shm/vypr
# Every window the game puts up, not only the main one: the launcher and its
# splash appear first and are worth seeing. This was narrowed to the game window
# alone while the launcher and game were stealing focus from each other; that
# was fixed by only letting clicks change focus, so both can stream again.
MATCHES=(FiveM Cfx Rockstar "Social Club")
export LIBVIRT_DEFAULT_URI=qemu:///system

say() {
    echo "vypr-fivem: $*"
    notify-send --app-name=FiveM --icon=vypr-fivem "FiveM" "$*" 2>/dev/null || true
}
die() {
    echo "vypr-fivem: $*" >&2
    notify-send --app-name=FiveM --icon=dialog-error -u critical "FiveM" "$*" 2>/dev/null || true
    exit 1
}

guest() {
    ssh -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=no -o LogLevel=ERROR \
        -o ConnectTimeout=8 "Lucy@$GUEST" "$@"
}

# --- the VM ----------------------------------------------------------------
state=$(virsh domstate "$VM" 2>/dev/null || echo missing)
[ "$state" = "missing" ] && die "VM '$VM' does not exist."

if [ "$state" != "running" ]; then
    say "Starting the VM..."
    virsh start "$VM" >/dev/null || die "could not start the VM"
fi

# Wait for the guest to answer, not merely for the domain to be 'running' -
# a booting Windows is not yet able to do anything useful.
for _ in $(seq 1 60); do
    guest 'echo ok' >/dev/null 2>&1 && break
    sleep 5
done
guest 'echo ok' >/dev/null 2>&1 || die "guest did not become reachable"

# Windows needs a logged-in session: no desktop means nothing to capture, and
# interactive scheduled tasks will not run.
#
# The output is captured before matching rather than piped: several of these
# Windows commands exit non-zero even when they succeed - 'query user' returns
# 1 with a user plainly listed - and under pipefail that exit status would
# propagate through the pipe and be read as "no session".
sessions=$(guest 'query user' 2>/dev/null || true)
if ! grep -qi console <<<"$sessions"; then
    die "nobody is logged in to Windows - auto-login should handle this, check the VM's screen"
fi

# --- the session daemon ----------------------------------------------------
#
# A window the user closed is remembered as dismissed, so that an app which
# ignores WM_CLOSE - as games routinely do - does not have its window reappear
# seconds later. The cost is that closing such a window leaves the app running
# with nothing showing it, and no way back.
#
# Clicking the icon is the way back: if the game is running but nothing is
# presenting it, restart the daemon, which forgets what was dismissed.
if pgrep -x vyprd >/dev/null && ! pgrep -x vypr-window >/dev/null; then
    running=$(guest 'tasklist' 2>/dev/null || true)
    if grep -qi 'GTAProcess' <<<"$running"; then
        say "Reattaching to the running game..."
        pkill -x vyprd
        sleep 2
    fi
fi

if ! pgrep -x vyprd >/dev/null; then
    say "Starting the vypr session..."
    [ -x "$SASH/vyprd" ] || die "$SASH/vyprd is missing - build it first"
    match_args=()
    for m in "${MATCHES[@]}"; do match_args+=(--match "$m"); done
    nohup "$SASH/vyprd" --shm "$SHM" "${match_args[@]}" \
        >"${XDG_RUNTIME_DIR:-/tmp}/vyprd.log" 2>&1 &
    sleep 2
fi

# --- the guest agent -------------------------------------------------------
#
# Never taskkill the agent: the IVSHMEM driver does not clean up after a
# TerminateProcess and leaves an unkillable process holding the device, which
# takes a guest reboot to clear. Ending the scheduled task lets it exit.
agent_ps=$(guest 'tasklist /fi "imagename eq vypr-agent.exe" /fo csv /nh' 2>/dev/null || true)
if ! grep -q vypr-agent <<<"$agent_ps"; then
    say "Starting the guest agent..."
    guest 'schtasks /end /tn vypr-agent >nul 2>&1 & schtasks /run /tn vypr-agent' >/dev/null 2>&1
    sleep 6
fi

# --- Parsec, for the mouse -------------------------------------------------
#
# Not for streaming - for its driver.
#
# vypr injects mouse motion with SendInput, which always goes through the Win32
# cursor pipeline. A game reading raw input for its camera - FiveM and GTA V
# both do - wants the lLastX/lLastY deltas a physical mouse produces, and gets
# MOUSE_MOVE_ABSOLUTE packets or zeroes instead, reads the cursor as (0,0), and
# whips the camera into a corner every frame. No userspace API can produce a
# real HID delta, so this is not fixable in vypr as it stands.
#
# Parsec's parsecvusba driver injects at the kernel HID level. With Parsec
# running, the deltas are genuine and the camera behaves. Until vypr grows its
# own virtual HID device, keeping Parsec in the tray is the fix.
parsec_ps=$(guest 'tasklist /fi "imagename eq parsecd.exe" /fo csv /nh' 2>/dev/null || true)
if ! grep -q parsecd <<<"$parsec_ps"; then
    say "Starting Parsec (its driver is what makes the mouse work)..."
    guest 'schtasks /end /tn vypr-parsec >nul 2>&1 & schtasks /run /tn vypr-parsec' >/dev/null 2>&1
    sleep 5
fi

# --- the game --------------------------------------------------------------
game_ps=$(guest 'tasklist' 2>/dev/null || true)
if grep -qi 'FiveM_b.*GTAProcess' <<<"$game_ps"; then
    say "FiveM is already running."
else
    say "Launching FiveM..."
    guest 'schtasks /end /tn vypr-fivem >nul 2>&1 & schtasks /run /tn vypr-fivem' >/dev/null 2>&1
fi

# --- wait for the window ---------------------------------------------------
for _ in $(seq 1 60); do
    pgrep -x vypr-window >/dev/null && { say "FiveM is on screen."; exit 0; }
    sleep 5
done

die "the game did not appear within five minutes - check ${XDG_RUNTIME_DIR:-/tmp}/vyprd.log"
