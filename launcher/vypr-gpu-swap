#!/usr/bin/env bash
#
# vypr-gpu-swap - move the passed-through GPU between the host and the VM.
#
# EXPERIMENTAL. Off unless you turn it on with `vypr gpu-swap --enable`.
#
# Without this, a GPU given to a VM is given to it at boot: vfio-pci claims it
# by device id before the nvidia driver is loaded, and Linux never sees it
# again until you reboot. That is a whole graphics card doing nothing whenever
# the VM is off.
#
# This unbinds it on demand instead. libvirt calls it from a hook: `prepare`
# hands the card to vfio-pci before the guest starts, `release` hands it back
# once the guest has stopped. Nothing needs a reboot and nothing needs the
# display manager restarted - provided the card is not the one drawing your
# desktop, which is checked rather than assumed.
#
#   vypr-gpu-swap to-vm   <domain>
#   vypr-gpu-swap to-host <domain>
#   vypr-gpu-swap status  <domain>
#
# The devices are read from the domain's own <hostdev> entries, so there is no
# second list to keep in step with the XML.
set -uo pipefail

CONF=/etc/vypr/gpu-swap.conf
SYSPCI=/sys/bus/pci

say()  { printf 'vypr-gpu-swap: %s\n' "$*"; }
die()  { printf 'vypr-gpu-swap: %s\n' "$*" >&2; exit 1; }

# --------------------------------------------------------------- the devices
#
# Every PCI hostdev the domain asks for, as 0000:BB:DD.F. A GPU is at least two
# of them - the display function and its HDMI audio - and they have to move
# together, because they share an IOMMU group and vfio takes the group or
# nothing.
#
# The XML comes from stdin when libvirt supplies it, and only otherwise from
# virsh. That is not a preference, it is the difference between working and
# hanging forever: libvirtd holds the domain's lock for the whole time the hook
# runs, so a `virsh dumpxml` from inside the hook waits on a lock that cannot
# be released until the hook it is blocking returns. Every later virsh command
# against that domain then queues behind it, and the VM never starts. libvirt
# already feeds the hook the full domain XML on stdin for exactly this reason.
devices_from_xml() {
    python3 -c '
import sys, xml.etree.ElementTree as ET
try:
    root = ET.fromstring(sys.stdin.read())
except Exception:
    sys.exit(1)
for hd in root.iter("hostdev"):
    if hd.get("type") != "pci":
        continue
    a = hd.find("./source/address")
    if a is None:
        continue
    def n(x, w):
        return format(int(a.get(x, "0"), 16), "0%dx" % w)
    print("%s:%s:%s.%s" % (n("domain", 4), n("bus", 2), n("slot", 2), n("function", 1)))
'
}

# Set once at entry: the XML libvirt handed us, or nothing.
DOMAIN_XML=""

# What libvirt handed us, or - only outside a hook, where there is no lock to
# deadlock against - what virsh can fetch.
domain_xml_text() {
    if [ -n "$DOMAIN_XML" ]; then
        printf '%s' "$DOMAIN_XML"
    else
        virsh --connect qemu:///system dumpxml --inactive "$1" 2>/dev/null
    fi
}

domain_devices() { domain_xml_text "$1" | devices_from_xml; }

driver_of() {
    local d="$1" p
    p=$(readlink -f "$SYSPCI/devices/$d/driver" 2>/dev/null) || return 0
    [ -n "$p" ] && basename "$p"
}

# Is anything using this card?
#
# This is the check that matters, and the obvious one does not work. The sysfs
# "enabled" attribute on each connector reads "disabled" for outputs the
# compositor is actively driving when the proprietary nvidia driver is loaded -
# measured on this machine with two 4K panels lit. Trusting it would have
# reported the card running the desktop as free to take.
#
# nvidia-smi is the thing that knows. It lists graphics (G) and compute (C)
# clients per GPU, so Xorg, the compositor and a CUDA job all show up.
# --query-compute-apps is not enough: it returns only C, and the processes that
# make unbinding catastrophic are all G.
nvidia_index_of() {
    local d="$1"
    command -v nvidia-smi >/dev/null || return 1
    nvidia-smi --query-gpu=index,pci.bus_id --format=csv,noheader 2>/dev/null |
        awk -F', *' -v w="$d" 'tolower($2) ~ tolower(w)"$" { print $1; exit }'
}

gpu_users() {
    local d="$1" idx
    idx=$(nvidia_index_of "$d") || return 0
    [ -n "$idx" ] || return 0
    nvidia-smi 2>/dev/null | sed -n '/Processes:/,$p' | awk -v g="$idx" '
        /^\| +[0-9]+ / {
            line = $0
            gsub(/^\| */, "", line); gsub(/ *\|$/, "", line)
            split(line, f, / +/)
            if (f[1] == g) printf "      pid %s  %s  %s\n", f[4], f[5], f[6]
        }'
}

# The sysfs fallback, for cards nvidia-smi has never heard of.
#
# Only for those. Under the nvidia driver this attribute is wrong in both
# directions and cannot be used at all: it read "disabled" for two 4K panels
# that were lit, and later "enabled" for an output with a cable in it that the
# compositor had switched off - which refused every swap on this machine with
# "it is driving a display" while nvidia-smi showed nothing on the card at all.
# On amdgpu and i915 it means what it says.
drives_a_display() {
    local d="$1" c st en
    for c in "$SYSPCI/devices/$d"/drm/card*/card*-*; do
        [ -e "$c/status" ] || continue
        st=$(cat "$c/status" 2>/dev/null)
        en=$(cat "$c/enabled" 2>/dev/null)
        [ "$st" = "connected" ] && [ "$en" = "enabled" ] && return 0
    done
    return 1
}

# Does libvirt move these devices itself?
#
# managed='yes' on a <hostdev> means libvirt detaches the device from its host
# driver before the guest starts and reattaches it afterwards - the swap,
# already implemented, by the thing that owns the domain. Doing it as well is
# not redundant so much as a race: both sides take the same PCI device lock,
# and the hook's write to drivers_probe waits for a reattach that is waiting
# for the hook to return. So when libvirt manages them, this checks and gets
# out of the way.
domain_managed() {
    domain_xml_text "$1" | python3 -c '
import sys, xml.etree.ElementTree as ET
try:
    root = ET.fromstring(sys.stdin.read())
except Exception:
    sys.exit(1)
pci = [h for h in root.iter("hostdev") if h.get("type") == "pci"]
sys.exit(0 if pci and all(h.get("managed") == "yes" for h in pci) else 1)
'
}

bind_to() {
    local d="$1" want="$2" cur
    cur=$(driver_of "$d")

    if [ "$cur" = "$want" ]; then
        say "$d already on $want"
        return 0
    fi

    if [ -n "$cur" ]; then
        echo "$d" > "$SYSPCI/drivers/$cur/unbind" 2>/dev/null \
            || die "$d: could not unbind from $cur (something is still using it)"
    fi

    # driver_override pins the next probe to exactly one driver. Without it the
    # kernel picks by id table and nvidia takes the card straight back.
    if [ "$want" = "auto" ]; then
        echo "" > "$SYSPCI/devices/$d/driver_override"
    else
        echo "$want" > "$SYSPCI/devices/$d/driver_override"
    fi

    echo "$d" > "$SYSPCI/drivers_probe" 2>/dev/null || true

    cur=$(driver_of "$d")
    if [ "$want" = "auto" ]; then
        # Verified, not just reported. If a vfio.conf named this card's ids at
        # boot, those ids are still in vfio-pci's live table and it re-claims
        # the device the instant it is re-probed - so the card never comes back
        # and the only sign is a line that reads like success.
        if [ "$cur" = "vfio-pci" ]; then
            say "$d is still on vfio-pci - it was claimed straight back."
            say "  vfio-pci was loaded with ids= for this card; deleting the"
            say "  modprobe.d file does not clear the running module. Run:"
            say "    echo '<vendor> <device>' > /sys/bus/pci/drivers/vfio-pci/remove_id"
            return 1
        fi
        say "$d -> ${cur:-(none)}"
    elif [ "$cur" != "$want" ]; then
        die "$d: wanted $want, ended up on ${cur:-nothing}"
    else
        say "$d -> $want"
    fi
}

# ------------------------------------------------------------------ commands

cmd_status() {
    local domain="$1" d
    for d in $(domain_devices "$domain"); do
        local users; users=$(gpu_users "$d")
        printf '  %s  driver=%-14s %s\n' "$d" "$(driver_of "$d" || echo none)" \
            "$([ -n "$users" ] && echo "IN USE" || echo free)"
        # if, not &&: a trailing test that fails is the loop's exit status, and
        # reporting a free card made `status` exit 1 as though it had failed.
        if [ -n "$users" ]; then printf '%s\n' "$users"; fi
    done
}

cmd_to_vm() {
    local domain="$1" devs d users
    devs=$(domain_devices "$domain")
    [ -n "$devs" ] || { say "$domain passes through no PCI devices; nothing to move"; return 0; }

    # Checked before anything is unbound, so a refusal leaves the machine
    # exactly as it was rather than half-swapped.
    for d in $devs; do
        users=$(gpu_users "$d")
        if [ -n "$users" ]; then
            printf 'vypr-gpu-swap: %s is still in use:\n%s\n' "$d" "$users" >&2
            die "$d: nothing may be holding the card. An X server opens every GPU it can see unless told not to - Option \"AutoAddGPU\" \"false\" in xorg.conf keeps it off this one."
        fi
        # Only where nvidia-smi could not answer. Asking sysfs about an nvidia
        # card contradicts the check above and loses to it. Emptiness is the
        # test, not the exit status: the function succeeds and prints nothing
        # for a card nvidia-smi does not list.
        if [ -z "$(nvidia_index_of "$d")" ] && drives_a_display "$d"; then
            die "$d is driving a display. Moving it would take your desktop with it - plug the monitors into the other card first."
        fi
    done

    if domain_managed "$domain"; then
        say "the card is free; libvirt will move it (managed='yes')"
        return 0
    fi

    for d in $devs; do bind_to "$d" vfio-pci; done
}

cmd_to_host() {
    local domain="$1" d
    # No refusals on the way back: the guest has stopped, the card is free, and
    # failing here would leave it bound to nothing at all.
    #
    # Devices on vfio-pci only. A card that is already back on its host driver
    # is not something to put back - unbinding it to rebind the same driver is
    # a long wait at best, and on a failed start, where the card never left, it
    # took the card away from a working desktop driver and hung in the probe.
    for d in $(domain_devices "$domain"); do
        if [ "$(driver_of "$d")" = "vfio-pci" ]; then
            bind_to "$d" auto
        else
            say "$d is on $(driver_of "$d" || echo nothing) already; leaving it"
        fi
    done
}

# --------------------------------------------------------------------- entry

[ $# -ge 1 ] || die "usage: vypr-gpu-swap {to-vm|to-host|status} <domain>"
action="$1"; shift
domain="${1:-}"

# The conf is the opt-in, and the only opt-in. Nothing here acts on a domain
# that is not named in it.
opted_in=""
if [ -r "$CONF" ]; then
    # shellcheck source=/dev/null
    . "$CONF"
    opted_in="${DOMAIN:-}"
fi

case "$action" in
    to-vm|to-host)
        # Whatever libvirt put on stdin. A terminal is not it - run by hand
        # there is no hook and no lock, so falling back to virsh is safe - and
        # neither is an empty pipe, which is what a hook of another shape, or
        # a caller redirecting from /dev/null, leaves behind.
        if [ ! -t 0 ]; then DOMAIN_XML=$(cat); fi
        case "$DOMAIN_XML" in *"<domain"*) ;; *) DOMAIN_XML="" ;; esac

        # The hook runs for every guest on the machine, so both of these are
        # ordinary "not mine" cases and must leave without a word and without a
        # failure. An exit code here aborts somebody else's VM: when this
        # returned "needs root" for an unconfigured machine, installing the
        # hook without the conf stopped every guest on the box from starting.
        [ -n "$opted_in" ]          || exit 0
        [ "$domain" = "$opted_in" ] || exit 0
        [ "$(id -u)" = 0 ] || die "needs root"
        [ "$action" = to-vm ] && cmd_to_vm "$domain" || cmd_to_host "$domain"
        ;;
    status)
        # Readable by anyone, about any domain, so the setup can be inspected
        # before any of it is turned on.
        [ -n "$domain" ] || domain="$opted_in"
        [ -n "$domain" ] || die "no domain given and none in $CONF"
        cmd_status "$domain"
        ;;
    *) die "unknown action '$action'" ;;
esac
