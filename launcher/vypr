#!/usr/bin/env bash
#
# Vypr - run a Windows application as a window on this desktop.
#
#   vypr run <app>      bring everything up and start the app
#   vypr add <app>      register a Windows application as a launchable app
#   vypr remove <app>   undo that - task, profile, menu entry and icons
#   vypr detect         find apps on the guest desktop and offer to add them
#   vypr open <file>    open a Linux file in the Windows app that handles it
#   vypr associate      make this desktop open .psd, .exe and friends that way
#   vypr --debug desktop  stream the guest's whole screen, for debugging
#   vypr apps           list registered apps
#   vypr up / down      start or stop the session on its own
#   vypr status         what is running
#   vypr doctor         check the setup for the things that go quietly wrong
#
# Every step is skipped if it is already done, so running this twice is safe.
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vypr"
CONF="$CONF_DIR/config"
APPS="$CONF_DIR/apps"
BIN="$(dirname "$(readlink -f "$0")")"
SHM=/dev/shm/vypr
KEY="$HOME/.ssh/vypr-guest"
export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"
SHM_SIZE_MB_DEFAULT=512

[ -f "$CONF" ] || { echo "vypr: not configured - run the installer first" >&2; exit 1; }
# shellcheck source=/dev/null
. "$CONF"
: "${VM:?VM is not set in $CONF}"
: "${GUEST:?GUEST is not set in $CONF}"
: "${GUEST_USER:=Lucy}"

APP_NAME="Vypr"; APP_ICON="vypr"

say() {
    echo "vypr: $*"
    notify-send --app-name="$APP_NAME" --icon="$APP_ICON" "$APP_NAME" "$*" 2>/dev/null || true
}
die() {
    echo "vypr: $*" >&2
    notify-send --app-name="$APP_NAME" --icon=dialog-error -u critical "$APP_NAME" "$*" 2>/dev/null || true
    exit 1
}
# Where the guest actually is.
#
# A fixed address in the config is a promise the VM does not keep: change the
# NIC's MAC - to hide the hypervisor from a game, say - and Windows sees a new
# adapter, takes a new lease, and everything here starts timing out against an
# address nothing answers on. libvirt already knows, so ask it.
resolve_guest() {
    if [ -n "${GUEST:-}" ] && [ "$GUEST" != "auto" ]; then
        ssh -n -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=no \
            -o LogLevel=ERROR -o ConnectTimeout=4 "$GUEST_USER@$GUEST" \
            'echo ok' >/dev/null 2>&1 && return 0
    fi

    local mac found
    mac=$(virsh dumpxml "$VM" 2>/dev/null | sed -n "s/.*mac address='\([^']*\)'.*/\1/p" | head -1)
    [ -n "$mac" ] || return 1

    found=$(virsh domifaddr "$VM" 2>/dev/null | awk '/ipv4/ { split($4, a, "/"); print a[1]; exit }')
    [ -n "$found" ] || found=$(virsh net-dhcp-leases default 2>/dev/null |
        awk -v m="$mac" 'tolower($3) == tolower(m) { split($5, a, "/"); ip = a[1] } END { if (ip) print ip }')
    [ -n "$found" ] || return 1

    if [ "$found" != "${GUEST:-}" ]; then
        echo "vypr: the guest is at $found now; using that"
        GUEST="$found"
        [ -w "$CONF" ] && sed -i "s/^GUEST=.*/GUEST=$found/" "$CONF" 2>/dev/null || true
    fi
    return 0
}

guest() {
    # -n so ssh does not read our stdin. Without it, any prompt after a remote
    # command finds its input already eaten - 'vypr detect' listed everything
    # and then took the empty answer as "add none".
    ssh -n -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=no -o LogLevel=ERROR \
        -o ConnectTimeout=8 "$GUEST_USER@$GUEST" "$@"
}
# The remote path is passed as it stands. Windows' sshd does not hand it to a
# shell, so a document called 'My Poster.psd' needs no quoting - and quoting it
# anyway makes the quotes part of the filename.
guest_put() {
    scp -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=no -o LogLevel=ERROR \
        -q "$1" "$GUEST_USER@$GUEST:$2"
}
guest_get() {
    scp -i "$KEY" -o BatchMode=yes -o StrictHostKeyChecking=no -o LogLevel=ERROR \
        -q "$GUEST_USER@$GUEST:$1" "$2"
}

# Pull the application's own icon out of the guest executable, so a registered
# app looks like itself in the menu rather than wearing the Vypr mark. Failing
# is fine and expected - a shortcut may point somewhere unreadable - so this
# reports success and the caller falls back.
icon_from_guest() {
    local target="$1" out="$2"
    local script; script=$(mktemp)
    cat > "$script" <<'PS1'
param([string]$Target, [string]$Out)
Add-Type -AssemblyName System.Drawing
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class Ico {
  [DllImport("user32.dll", CharSet=CharSet.Unicode)]
  public static extern int PrivateExtractIcons(string file, int index, int cx, int cy,
                                               IntPtr[] icons, int[] ids, int count, int flags);
  [DllImport("user32.dll")] public static extern bool DestroyIcon(IntPtr h);
}
"@
<#
  Find the image Windows itself shows for this thing.

  A shortcut may name its own icon, and that is what the desktop draws - the
  target executable's icon can be something else entirely, or absent. Steam
  writes .url files rather than shortcuts, and keeps the artwork it downloaded
  in a separate .ico that only the .url points at, which is why a Steam game
  registered by URL had no icon at all to find.

  So: whatever the file says its icon is, then the thing it launches, then give
  up and let the caller fall back.
#>
$index = 0
$sources = @()

if ($Target.ToLower().EndsWith(".lnk")) {
    $sh = New-Object -ComObject WScript.Shell
    $lnk = $sh.CreateShortcut($Target)
    if ($lnk.IconLocation) {
        # Stored as "path,index"; an empty path means "use the target".
        $parts = $lnk.IconLocation -split ',(?=[^,]*$)'
        if ($parts[0].Trim()) {
            $sources += $parts[0].Trim('"').Trim()
            if ($parts.Count -gt 1) { [int]::TryParse($parts[1], [ref]$index) | Out-Null }
        }
    }
    if ($lnk.TargetPath) { $sources += $lnk.TargetPath }
}
elseif ($Target.ToLower().EndsWith(".url")) {
    $icon = (Select-String -LiteralPath $Target -Pattern '^IconFile=(.+)$' |
             Select-Object -First 1)
    if ($icon) { $sources += $icon.Matches.Groups[1].Value.Trim() }
    $idx = (Select-String -LiteralPath $Target -Pattern '^IconIndex=(.+)$' |
            Select-Object -First 1)
    if ($idx) { [int]::TryParse($idx.Matches.Groups[1].Value.Trim(), [ref]$index) | Out-Null }
}
else {
    $sources += $Target
}

$sources = $sources | Where-Object { $_ -and (Test-Path -LiteralPath $_ -ErrorAction SilentlyContinue) }
if (-not $sources) { exit 1 }

foreach ($src in $sources) {
foreach ($size in 256,128,64,48,32) {
    $h = New-Object IntPtr[] 1
    $id = New-Object int[] 1
    $n = [Ico]::PrivateExtractIcons($src, $index, $size, $size, $h, $id, 1, 0)
    if ($n -gt 0 -and $h[0] -ne [IntPtr]::Zero) {
        $bmp = [System.Drawing.Icon]::FromHandle($h[0]).ToBitmap()
        $bmp.Save($Out, [System.Drawing.Imaging.ImageFormat]::Png)
        [Ico]::DestroyIcon($h[0]) | Out-Null
        exit 0
    }
}
}
exit 1
PS1
    guest_put "$script" 'C:/Windows/Temp/vypr-icon.ps1' || { rm -f "$script"; return 1; }
    rm -f "$script"
    guest "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Windows\\Temp\\vypr-icon.ps1 -Target \"$target\" -Out C:\\Windows\\Temp\\vypr-icon.png" >/dev/null 2>&1 || return 1
    guest_get 'C:/Windows/Temp/vypr-icon.png' "$out" || return 1
    [ -s "$out" ]
}

# ---------------------------------------------------------- the shared region
#
# The tmpfiles rule recreates /dev/shm/vypr at every boot with the right owner,
# but tmpfiles has no way to give a file a size, so it comes back empty. vyprd
# reads the size from the file and refuses one that is too small, and QEMU only
# sizes it if the VM happens to start first. Rather than depend on that order,
# give it its size here - the owner can, and it costs nothing when already right.
ensure_region() {
    local want=$(( ${SHM_SIZE_MB:-$SHM_SIZE_MB_DEFAULT} * 1024 * 1024 ))
    if [ ! -e "$SHM" ]; then
        die "$SHM does not exist - the tmpfiles rule the installer printed was never applied"
    fi
    local have
    have=$(stat -c%s "$SHM" 2>/dev/null || echo 0)
    if [ "$have" -lt "$want" ]; then
        truncate -s "$want" "$SHM" 2>/dev/null || \
            die "$SHM is $have bytes and could not be grown to $want"
    fi
}

# --------------------------------------------------------------- the VM
start_vm() {
    local state
    state=$(virsh domstate "$VM" 2>/dev/null || echo missing)
    [ "$state" = "missing" ] && die "VM '$VM' does not exist"

    if [ "$state" != "running" ]; then
        say "Starting the VM..."
        virsh start "$VM" >/dev/null || die "could not start the VM"
    fi

    # Wait for the guest to answer, not merely for the domain to say 'running' -
    # a booting Windows cannot do anything useful yet.
    local i
    for i in $(seq 1 60); do
        guest 'echo ok' >/dev/null 2>&1 && break
        # Periodically re-ask libvirt, in case it came up somewhere else.
        [ $((i % 6)) -eq 0 ] && resolve_guest >/dev/null 2>&1
        sleep 5
    done
    resolve_guest >/dev/null 2>&1 || true
    guest 'echo ok' >/dev/null 2>&1 || die "the guest never answered - check the VM's screen"

    # Windows needs a logged-in session: no desktop means nothing to capture,
    # and interactive scheduled tasks will not run. 'query user' exits non-zero
    # even when it lists a user, so capture before matching rather than piping.
    local sessions
    sessions=$(guest 'query user' 2>/dev/null || true)
    grep -qi console <<<"$sessions" || \
        die "nobody is logged in to Windows - enable auto-login, or log in on the VM's screen"
}

# ----------------------------------------------------------- the guest agent
#
# Never taskkill the agent: the IVSHMEM driver does not clean up after a
# TerminateProcess and leaves an unkillable process holding the device, which
# takes a guest reboot to clear. Ending the scheduled task lets it exit.
start_agent() {
    local ps
    ps=$(guest 'tasklist /fi "imagename eq vypr-agent.exe" /fo csv /nh' 2>/dev/null || true)
    if ! grep -q vypr-agent <<<"$ps"; then
        say "Starting the guest agent..."
        guest 'schtasks /end /tn vypr-agent >nul 2>&1 & schtasks /run /tn vypr-agent' >/dev/null 2>&1
        sleep 6
    fi
}

# --------------------------------------------------- Parsec, for the mouse
#
# Not for streaming, and not for the display either - only for its driver.
#
# Vypr injects mouse motion with SendInput, which always goes through the Win32
# cursor pipeline. A game reading raw input for its camera wants the lLastX and
# lLastY deltas a physical mouse produces, and gets MOUSE_MOVE_ABSOLUTE packets
# or zeroes instead, reads the cursor as (0,0), and whips the camera into a
# corner every frame. No userspace API can produce a real HID delta, so this is
# not fixable in Vypr as it stands. Parsec's parsecvusba driver injects at the
# kernel HID level, and with it running the deltas are genuine.
#
# It was also believed to be what gave the VM a display, because an agent
# started without it once reported the capture API as unavailable. That was
# wrong: with a monitor or a dummy plug on the passed-through GPU the display
# is there regardless, measured with Parsec killed - the adapter still drove
# 3840x2160 and the agent started clean. So this is only about the mouse, and
# only for games that read raw input. USE_PARSEC=0 turns it off.
start_parsec() {
    [ "${USE_PARSEC:-1}" = "1" ] || return 0
    local ps
    ps=$(guest 'tasklist /fi "imagename eq parsecd.exe" /fo csv /nh' 2>/dev/null || true)
    if ! grep -q parsecd <<<"$ps"; then
        say "Starting Parsec (its driver is what makes the mouse work in games)..."
        guest 'schtasks /end /tn vypr-parsec >nul 2>&1 & schtasks /run /tn vypr-parsec' >/dev/null 2>&1
        sleep 5
    fi
}

# --------------------------------------------------------- the session daemon
# What the running daemon was told to look for, so we can tell whether it is
# watching for this app or a different one.
daemon_matches() {
    local pid
    pid=$(pgrep -x vyprd | head -1) || return 1
    [ -n "$pid" ] || return 1
    tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null |
        awk '$0 == "--match" { getline; print }' | sort -u
}

start_daemon() {
    local -n _m=$1
    # A window the user closed is remembered as dismissed, so an app that
    # ignores WM_CLOSE - as games routinely do - does not have its window
    # reappear seconds later. The cost is that closing such a window leaves the
    # app running with nothing showing it. Relaunching is the way back: if the
    # app is running but nothing is presenting it, restart the daemon, which
    # forgets what was dismissed.
    if pgrep -x vyprd >/dev/null && ! pgrep -x vypr-window >/dev/null; then
        if [ -n "${PROCESS:-}" ] && grep -qi "$PROCESS" <<<"$(guest 'tasklist' 2>/dev/null || true)"; then
            say "Reattaching to the running app..."
            pkill -x vyprd
            sleep 2
        fi
    fi

    # A daemon started for a different app is watching for that app's window
    # titles and will ignore this one - the window is offered and logged as
    # 'no title match'. Restart it with both sets, so launching a second app
    # does not silently do nothing and does not stop streaming the first.
    if pgrep -x vyprd >/dev/null; then
        local running wanted
        running=$(daemon_matches)
        wanted=$(printf '%s\n' "${_m[@]}" | sort -u)
        if [ -n "$(comm -13 <(printf '%s\n' "$running") <(printf '%s\n' "$wanted"))" ]; then
            say "Restarting the session to watch for $APP_NAME as well..."
            # sed, not grep: a title can carry bytes that make grep call the
            # stream binary and print a warning instead of the lines.
            mapfile -t _m < <(printf '%s\n%s\n' "$running" "$wanted" | sed '/^$/d' | sort -u)
            pkill -x vyprd
            sleep 2
        fi
    fi

    if ! pgrep -x vyprd >/dev/null; then
        say "Starting the Vypr session..."
        [ -x "$BIN/vyprd" ] || die "$BIN/vyprd is missing - reinstall"
        local args=() m
        for m in "${_m[@]}"; do args+=(--match "$m"); done
        nohup "$BIN/vyprd" --shm "$SHM" "${args[@]}" \
            >"${XDG_RUNTIME_DIR:-/tmp}/vyprd.log" 2>&1 &
        sleep 2
    fi
}

# --------------------------------------------------- shutting the VM down
#
# Nothing else is watching: 'vypr run' returns as soon as the app is on screen,
# and vyprd stays up waiting for more windows. So a supervisor is started
# alongside the session, and when the last streamed window has been gone for
# the grace period it tears the session down and asks the VM to shut down.
#
# The grace period is not politeness - it is what makes this recoverable. A game
# whose window you closed by accident is one relaunch away from cancelling the
# shutdown, because a window appearing resets the count.
watch_and_shutdown() {
    [ "${SHUTDOWN_VM_ON_EXIT:-1}" = "1" ] || exit 0
    local grace="${SHUTDOWN_GRACE:-60}"

    # Wait for the session to actually start before deciding it has ended.
    local i
    for i in $(seq 1 60); do
        pgrep -x vypr-window >/dev/null && break
        sleep 5
    done
    pgrep -x vypr-window >/dev/null || exit 0

    local idle=0 warned=0
    while true; do
        if pgrep -x vypr-window >/dev/null; then
            idle=0
            warned=0
        else
            if [ "$warned" = "0" ]; then
                say "Nothing left on screen - shutting the VM down in ${grace}s. Launch something to cancel."
                warned=1
            fi
            idle=$((idle + 5))
            [ "$idle" -ge "$grace" ] && break
        fi
        sleep 5
    done

    pkill -x vyprd 2>/dev/null
    guest 'schtasks /end /tn vypr-agent' >/dev/null 2>&1

    # Graceful, so Windows closes things properly. A guest that refuses - a
    # crash dialog holding it open, which has happened here - is left running
    # rather than pulled out from under, since forcing it risks the disk.
    virsh shutdown "$VM" >/dev/null 2>&1
    for i in $(seq 1 30); do
        [ "$(virsh domstate "$VM" 2>/dev/null)" = "shut off" ] && { say "VM is off."; exit 0; }
        sleep 10
    done
    say "The VM did not shut down - something in Windows is holding it open."
}

start_watcher() {
    [ "${SHUTDOWN_VM_ON_EXIT:-1}" = "1" ] || return 0
    command -v flock >/dev/null 2>&1 || return 0
    # flock -n keeps this to one watcher however many times 'vypr run' is used.
    setsid nohup flock -n "${XDG_RUNTIME_DIR:-/tmp}/vypr-watch.lock" \
        "$0" __watch >>"${XDG_RUNTIME_DIR:-/tmp}/vypr-watch.log" 2>&1 &
}

# -------------------------------------------------------------- subcommands
cmd_run() {
    local app="${1:-}"
    [ -n "$app" ] || die "usage: vypr run <app>   (see 'vypr apps')"
    local profile="$APPS/$app.conf"
    [ -f "$profile" ] || die "no such app '$app' - see 'vypr apps', or add it with 'vypr add'"
    # shellcheck source=/dev/null
    . "$profile"
    APP_NAME="${NAME:-$app}"; APP_ICON="${ICON:-vypr}"
    : "${MATCHES:?$profile does not set MATCHES}"
    : "${TASK:?$profile does not set TASK}"

    ensure_region
    start_vm
    start_daemon MATCHES
    start_agent
    start_parsec

    if [ -n "${PROCESS:-}" ] && grep -qi "$PROCESS" <<<"$(guest 'tasklist' 2>/dev/null || true)"; then
        say "$APP_NAME is already running."
    else
        say "Launching $APP_NAME..."
        guest "schtasks /end /tn $TASK >nul 2>&1 & schtasks /run /tn $TASK" >/dev/null 2>&1
    fi

    start_watcher

    local i
    for i in $(seq 1 60); do
        pgrep -x vypr-window >/dev/null && { say "$APP_NAME is on screen."; exit 0; }
        sleep 5
    done
    die "$APP_NAME did not appear within five minutes - check ${XDG_RUNTIME_DIR:-/tmp}/vyprd.log"
}

# ------------------------------------------------- opening a Linux file
#
# The guest cannot see this filesystem, so the file is copied in, opened with
# whatever Windows associates with it, and copied back whenever the application
# saves. To the person doing it, double-clicking a .psd opens Photoshop and
# Ctrl+S writes to the file they double-clicked.
#
# The copy is the part worth being careful about. An application that saves is
# not editing the file you opened, it is editing the guest's copy of it, and
# unless something carries that back the work is stranded in the VM. So a
# watcher follows the guest copy for as long as the session lasts and writes
# each new version back over the original.
#
# A shared folder would avoid the round trip entirely - the application would
# open the real file - but that needs virtiofs set up on both sides, and this
# has to work whether or not it is.
# Two spellings of one directory. Windows' own tools want backslashes; scp
# reads the remote path itself and treats a backslash as an escape, so
# everything that goes through it uses the forward-slash form - which
# PowerShell is equally happy with.
OPEN_DIR_WIN='C:\ProgramData\Vypr\open'
OPEN_DIR_SCP='C:/ProgramData/Vypr/open'

# LastWriteTime and length together, as one string. Either alone misses an edit
# that keeps the other the same.
guest_stamp() {
    guest "powershell -NoProfile -Command \"\$f='$1'; if (Test-Path -LiteralPath \$f) { \$i=Get-Item -LiteralPath \$f; Write-Output (\\\"{0}:{1}\\\" -f \$i.LastWriteTimeUtc.Ticks, \$i.Length) } else { Write-Output 'gone' }\"" 2>/dev/null | tr -d '\r' | tail -1
}

# Copy the guest's version back over the file the user opened.
#
# Written beside the original and moved into place, so an interrupted copy
# cannot leave a half-written file where the whole one was - and so the
# original's permissions and ownership survive.
sync_back() {
    local original="$1" remote="$2" tmp
    tmp=$(mktemp "$(dirname -- "$original")/.vypr-XXXXXX") || return 1
    if guest_get "$remote" "$tmp"; then
        chmod --reference="$original" "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$original" && return 0
    fi
    rm -f "$tmp"
    return 1
}

# The watcher, run in the background by 'vypr open'.
#
# It polls rather than being told, because nothing in the guest is going to
# tell us. Two identical readings before copying: an application part way
# through writing a large file has a size that is changing, and copying then
# would fetch half a document.
watch_and_sync() {
    local original="$1" remote="$2"
    local last stamp settled=""

    # One watcher per file. Opening the same document twice would otherwise
    # leave two of them copying the same changes over each other.
    local lock
    lock="${XDG_RUNTIME_DIR:-/tmp}/vypr-sync-$(printf '%s' "$original" | md5sum | cut -c1-16).lock"
    exec 9>"$lock" || exit 0
    flock -n 9 || exit 0

    last=$(guest_stamp "$remote")
    while pgrep -x vyprd >/dev/null 2>&1; do
        sleep 3
        stamp=$(guest_stamp "$remote")
        [ -n "$stamp" ] || continue
        [ "$stamp" = "gone" ] && break
        [ "$stamp" = "$last" ] && { settled=""; continue; }

        if [ "$stamp" = "$settled" ]; then
            if sync_back "$original" "$remote"; then
                say "Saved back to $(basename -- "$original")"
                last="$stamp"
            fi
            settled=""
        else
            settled="$stamp"
        fi
    done
    exit 0
}

cmd_open() {
    local file="${1:-}"
    [ -n "$file" ] || die "usage: vypr open <file>"
    [ -e "$file" ] || die "no such file: $file"
    [ -f "$file" ] || die "$file is not a file - only files can be opened this way"
    file=$(readlink -f -- "$file")

    local base stem
    base=$(basename -- "$file")
    stem="${base%.*}"
    APP_NAME="$base"

    ensure_region
    start_vm
    resolve_guest || die "cannot work out where the guest is - is the VM running?"

    # An application titles its window after the document, so the file's own
    # name is what to watch for. Both forms: some show the extension, some do
    # not.
    local MATCHES=("$stem" "$base")
    start_daemon MATCHES
    start_agent
    start_parsec

    say "Copying $base into the guest..."
    guest "if not exist \"$OPEN_DIR_WIN\" mkdir \"$OPEN_DIR_WIN\"" >/dev/null 2>&1
    guest_put "$file" "$OPEN_DIR_SCP/$base" || die "could not copy $base into the guest"

    # Through a scheduled task, not over ssh: an ssh session is not the
    # interactive desktop, and a window opened from one appears on a desktop
    # nobody is looking at and nothing can capture.
    say "Opening $base in Windows..."
    guest "schtasks /delete /tn vypr-open /f >nul 2>&1 & schtasks /create /tn vypr-open /tr \"cmd /c start \\\"\\\" \\\"$OPEN_DIR_WIN\\\\$base\\\"\" /sc once /st 00:00 /it /rl limited /f" \
        >/dev/null 2>&1 || die "could not create the scheduled task in the guest"
    guest "schtasks /run /tn vypr-open" >/dev/null 2>&1

    # Saves in the guest come back here for as long as the session lasts.
    nohup "$0" __sync "$file" "$OPEN_DIR_SCP/$base" \
        >>"${XDG_RUNTIME_DIR:-/tmp}/vypr-sync.log" 2>&1 &
    disown 2>/dev/null || true

    start_watcher

    local i
    for i in $(seq 1 24); do
        pgrep -x vypr-window >/dev/null && { say "$base is open in Windows."; exit 0; }
        sleep 5
    done
    echo "vypr: nothing appeared within two minutes." >&2
    echo "vypr: the guest may have opened it in a window titled something other" >&2
    echo "      than '$stem'. 'vypr --debug desktop' shows the whole screen." >&2
    exit 1
}

# ------------------------------------------- making double-click do that
#
# The MIME types Windows applications are the obvious answer for. PSD has two
# names in the wild, and executables have collected several over the years;
# registering all of them costs nothing and missing one means a file that
# quietly opens in something else.
OPEN_MIMES=(
    image/vnd.adobe.photoshop
    image/x-psd
    application/x-ms-dos-executable
    application/x-msdownload
    application/vnd.microsoft.portable-executable
    application/x-msi
)

cmd_associate() {
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local entry="$apps/vypr-open.desktop"

    if [ "${1:-}" = "--remove" ]; then
        rm -f "$entry"
        update-desktop-database "$apps" 2>/dev/null || true
        say "Vypr is no longer offered for those files. Your file manager may"
        say "need to be restarted before it stops using it."
        return 0
    fi

    mkdir -p "$apps"
    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=Open in Windows (Vypr)"
        echo "Comment=Open this file in the Windows application that handles it"
        echo "Exec=$BIN/vypr open %f"
        echo "Icon=vypr"
        echo "Terminal=false"
        echo "NoDisplay=true"
        printf 'MimeType=%s;\n' "$(IFS=';'; echo "${OPEN_MIMES[*]}")"
    } > "$entry"
    update-desktop-database "$apps" 2>/dev/null || true

    local m
    for m in "${OPEN_MIMES[@]}"; do
        xdg-mime default vypr-open.desktop "$m" 2>/dev/null || true
    done

    say "Double-clicking these will now open them in the VM:"
    printf '        %s\n' "${OPEN_MIMES[@]}"
    say "'vypr associate --remove' puts that back."
}

# What to look for in a window title, when the user has not said.
#
# The display name, the short name and the executable's own basename, which
# between them cover how apps actually title their windows: Notepad calls its
# window 'Untitled - Notepad', so the bare name is enough. Anything beyond that
# is app-specific - FiveM also puts up Cfx, Rockstar and Social Club windows -
# and belongs in that app's --match flags rather than in everyone's defaults.
# Steam's own name for an app id. A steam:// URL says nothing about what the
# game calls its window, but Steam wrote the name down when it installed it.
steam_app_name() {
    guest "reg query \"HKCU\\Software\\Valve\\Steam\\Apps\\$1\" /v Name" 2>/dev/null |
        sed -n 's/^[[:space:]]*Name[[:space:]]*REG_SZ[[:space:]]*//p' | tr -d '\r'
}

derive_matches() {
    local app="$1" label="$2" path="$3"
    local base="${path##*\\}"      # drop the Windows directories
    base="${base##*/}"
    base="${base%.*}"               # and the .exe or .lnk

    # The last element of a steam:// URL is the app id, which no window is ever
    # titled. Ask Steam what the game is actually called instead.
    local steam_name=""
    if [[ "$path" =~ ^steam://(rungameid|run)/([0-9]+) ]]; then
        steam_name=$(steam_app_name "${BASH_REMATCH[2]}")
        base=""
    fi

    local out=() cand have dup
    for cand in "$label" "$steam_name" "$app" "$base"; do
        [ -n "$cand" ] || continue
        # A bare number is an id, not a title.
        [[ "$cand" =~ ^[0-9]+$ ]] && continue
        dup=0
        for have in ${out[@]+"${out[@]}"}; do
            [ "${have,,}" = "${cand,,}" ] && { dup=1; break; }
        done
        [ "$dup" = "0" ] && out+=("$cand")
    done
    printf '%s\n' ${out[@]+"${out[@]}"}
}

cmd_add() {
    local app="${1:-}" path="${2:-}"
    if [ -z "$app" ] || [ -z "$path" ]; then
        cat >&2 <<EOF
usage: vypr add <name> '<windows path to the .exe or shortcut>'

  e.g. vypr add notepad 'C:\\Windows\\System32\\notepad.exe'
       vypr add fivem   'C:\\Users\\Me\\Desktop\\FiveM.lnk'

  Optional, and worth setting for games:
    --match <text>     window titles to stream (repeatable; defaults to <name>)
    --process <exe>    how to tell it is already running, e.g. GTAProcess
    --name <text>      the name to show in your application menu
    --elevated         run it as administrator (most games refuse this)
    --icon <file.png>  use this icon instead of the one in the .exe
    --icon-from <path> a Windows file to take the icon from, when the
                       thing being launched is not one (a steam:// URL)
    --no-desktop-icon  only add it to the application menu, not the desktop
EOF
        return 1
    fi
    shift 2

    local matches=() process="" label="" elevated=0 iconfile="" iconfrom="" desktop_icon=1 m
    while [ $# -gt 0 ]; do
        case "$1" in
            --match)   matches+=("$2"); shift 2 ;;
            --process) process="$2"; shift 2 ;;
            --name)    label="$2"; shift 2 ;;
            --elevated) elevated=1; shift ;;
            --icon)    iconfile="$2"; shift 2 ;;
            --icon-from) iconfrom="$2"; shift 2 ;;
            --no-desktop-icon) desktop_icon=0; shift ;;
            *) die "unknown option '$1'" ;;
        esac
    done
    [ -n "$label" ] || label="$app"
    if [ "${#matches[@]}" -eq 0 ]; then
        mapfile -t matches < <(derive_matches "$app" "$label" "$path")
    fi

    start_vm

    # The task must be interactive - a non-interactive task has no desktop to
    # draw on - but it must NOT be elevated by default. Several games refuse to
    # start as administrator outright: FiveM says so and exits. The agent runs
    # elevated so it can see and drive elevated windows, and injecting input
    # downwards from there works, so the app itself has no reason to be.
    # Pass --elevated for the rare application that demands it.
    #
    # It is run through 'cmd /c start' rather than directly because Task
    # Scheduler launches with CreateProcess, which cannot open a .lnk - and
    # desktop shortcuts are how people usually point at a game. 'start' goes
    # through the shell, which resolves them.
    local task="vypr-$app"
    say "Registering '$label' in the guest..."
    local level="limited"
    [ "$elevated" = "1" ] && level="highest"
    guest "schtasks /delete /tn $task /f >nul 2>&1 & schtasks /create /tn $task /tr \"cmd /c start \\\"\\\" \\\"$path\\\"\" /sc once /st 00:00 /it /rl $level /f" \
        >/dev/null 2>&1 || die "could not create the scheduled task in the guest"

    mkdir -p "$APPS"
    {
        echo "NAME=\"$label\""
        echo "TASK=$task"
        [ -n "$process" ] && echo "PROCESS=\"$process\""
        printf 'MATCHES=('
        for m in "${matches[@]}"; do printf '"%s" ' "$m"; done
        echo ')'
    } > "$APPS/$app.conf"

    # The app's own icon if we can get one, the Vypr mark if we cannot.
    local icon_name="vypr"
    local icon_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
    local staged="${TMPDIR:-/tmp}/vypr-icon-$app.png"
    if [ -n "$iconfile" ] && [ -f "$iconfile" ]; then
        install -Dm644 "$iconfile" "$icon_dir/vypr-$app.png" && icon_name="vypr-$app"
    elif icon_from_guest "${iconfrom:-$path}" "$staged"; then
        install -Dm644 "$staged" "$icon_dir/vypr-$app.png" && icon_name="vypr-$app"
        rm -f "$staged"
    fi
    gtk-update-icon-cache -qtf "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" 2>/dev/null || true

    local desktop="${XDG_DATA_HOME:-$HOME/.local/share}/applications/vypr-$app.desktop"
    mkdir -p "$(dirname "$desktop")"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$label
Comment=Runs in Windows, shown here by Vypr
Exec=$BIN/vypr run $app
Icon=$icon_name
Terminal=false
Categories=Game;
EOF
    update-desktop-database "$(dirname "$desktop")" 2>/dev/null || true

    # And on the desktop itself. Plasma and GNOME both refuse to launch a
    # desktop file that is not executable, warning about untrusted content
    # instead, so it is installed 755 rather than 644 like the menu entry.
    if [ "$desktop_icon" = "1" ]; then
        local dtop
        dtop=$(xdg-user-dir DESKTOP 2>/dev/null) || dtop=""
        [ -n "$dtop" ] || dtop="$HOME/Desktop"
        if [ -d "$dtop" ]; then
            # The display name is what the user will read under the icon, but a
            # slash in it would be a path separator here.
            local file="${label//\//-}"
            install -Dm755 "$desktop" "$dtop/$file.desktop"
            say "Added an icon to your desktop."
        else
            echo "vypr: no desktop directory at $dtop; added to the application menu only"
        fi
    fi

    echo
    say "'$label' is ready. Launch it from your application menu, or: vypr run $app"
}

cmd_remove() {
    local app="${1:-}" force=0
    [ "${2:-}" = "--force" ] && force=1
    [ -n "$app" ] || die "usage: vypr remove <app> [--force]   (see 'vypr apps')"
    local profile="$APPS/$app.conf"
    [ -f "$profile" ] || die "no such app '$app' - see 'vypr apps'"

    # shellcheck source=/dev/null
    . "$profile"
    local label="${NAME:-$app}"
    local removed=0

    # The guest task first, because it is the only part that needs the VM, and
    # the local files should not be torn down if it is unreachable and the user
    # would rather try again later.
    if [ "$(virsh domstate "$VM" 2>/dev/null)" = "running" ] && guest 'echo ok' >/dev/null 2>&1; then
        if guest "schtasks /delete /tn ${TASK:-vypr-$app} /f" >/dev/null 2>&1; then
            echo "  removed the scheduled task from the guest"
            removed=1
        fi
    elif [ "$force" = "1" ]; then
        echo "  the VM is not reachable, so '${TASK:-vypr-$app}' stays registered in the guest"
    else
        # Removing the profile now would delete the only record of which task to
        # clear, so 'run this again later' would be advice that cannot be taken.
        echo "vypr: the VM is not running, so the guest still has '${TASK:-vypr-$app}'." >&2
        echo "      Start it and run this again, or 'vypr remove $app --force' to" >&2
        echo "      remove everything on this side and leave that task behind." >&2
        exit 1
    fi

    local dtop
    dtop=$(xdg-user-dir DESKTOP 2>/dev/null) || dtop=""
    [ -n "$dtop" ] || dtop="$HOME/Desktop"

    local f
    for f in "$profile" \
             "${XDG_DATA_HOME:-$HOME/.local/share}/applications/vypr-$app.desktop" \
             "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps/vypr-$app.png" \
             "$dtop/${label//\//-}.desktop"; do
        if [ -e "$f" ]; then
            rm -f "$f" && echo "  removed $f"
            removed=1
        fi
    done

    update-desktop-database "${XDG_DATA_HOME:-$HOME/.local/share}/applications" 2>/dev/null || true
    gtk-update-icon-cache -qtf "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" 2>/dev/null || true

    [ "$removed" = "1" ] && say "'$label' removed." || echo "vypr: nothing to remove"
}

# Find what is on the guest's desktop and offer to register it.
#
# Reads both desktops - the user's and the shared All Users one - because
# installers scatter shortcuts across either, and resolves each shortcut to the
# executable it points at so a name and an icon can be had from it.
cmd_detect() {
    start_vm

    local script; script=$(mktemp)
    cat > "$script" <<'PS1'
# Names carry (R) and similar; without this they arrive mangled through the
# console codepage and end up in the menu entry that way.
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$sh = New-Object -ComObject WScript.Shell
$dirs = @(
  [Environment]::GetFolderPath('Desktop'),
  [Environment]::GetFolderPath('CommonDesktopDirectory')
) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -Unique

$skip = '(?i)uninstall|readme|website|support'

foreach ($d in $dirs) {
  Get-ChildItem -LiteralPath $d -Filter *.lnk -ErrorAction SilentlyContinue | ForEach-Object {
    $target = ""
    try { $target = $sh.CreateShortcut($_.FullName).TargetPath } catch { }
    # Shortcuts to folders, documents and uninstallers are not applications.
    if ($target -and $target.ToLower().EndsWith(".exe") -and $_.BaseName -notmatch $skip) {
      "{0}`t{1}`t{2}" -f $_.BaseName, $_.FullName, $_.FullName
    }
  }

  # Steam writes .url files, not shortcuts, so a Steam library is invisible to
  # the pass above - and those are exactly the things worth streaming.
  Get-ChildItem -LiteralPath $d -Filter *.url -ErrorAction SilentlyContinue | ForEach-Object {
    $url = (Select-String -LiteralPath $_.FullName -Pattern '^URL=(.+)$' |
            Select-Object -First 1).Matches.Groups[1].Value
    if ($url -and $url -match '^steam://' -and $_.BaseName -notmatch $skip) {
      # Third field is where the icon lives: the .url itself names it, while
      # the steam:// URL that launches the game is not a file at all.
      "{0}`t{1}`t{2}" -f $_.BaseName, $url.Trim(), $_.FullName
    }
  }
}
PS1
    guest_put "$script" 'C:/Windows/Temp/vypr-detect.ps1' || { rm -f "$script"; die "could not reach the guest"; }
    rm -f "$script"

    local found=()
    mapfile -t found < <(guest 'powershell -NoProfile -ExecutionPolicy Bypass -File C:\Windows\Temp\vypr-detect.ps1' 2>/dev/null | tr -d '\r')

    [ "${#found[@]}" -gt 0 ] || { say "Nothing on the guest desktop looks like an application."; return 0; }

    echo
    echo "  Found on the Windows desktop:"
    echo
    local i=1 name path line
    for line in "${found[@]}"; do
        name="${line%%$'\t'*}"
        # Already registered? Say so rather than offering it again.
        local known=""
        for f in "$APPS"/*.conf; do
            [ -e "$f" ] || continue
            # Case-insensitively: the same game registered by hand and by
            # detection differ only in how the shortcut happened to be spelt.
            grep -qi "^NAME=\"$name\"$" "$f" 2>/dev/null && known="  (already added)"
        done
        printf '    %2d) %s%s\n' "$i" "$name" "$known"
        i=$((i + 1))
    done
    echo
    echo "  Which would you like to add? Numbers separated by spaces, 'all', or"
    read -rp "  blank to add none: " picks
    [ -n "$picks" ] || { echo "  Nothing added."; return 0; }

    local chosen=()
    if [ "$picks" = "all" ]; then
        chosen=($(seq 1 "${#found[@]}"))
    else
        chosen=($picks)
    fi

    local n
    for n in "${chosen[@]}"; do
        case "$n" in (*[!0-9]*|"") echo "  skipping '$n'"; continue ;; esac
        [ "$n" -ge 1 ] && [ "$n" -le "${#found[@]}" ] || { echo "  no item $n"; continue; }
        line="${found[$((n - 1))]}"
        name="${line%%$'\t'*}"
        local rest="${line#*$'\t'}"
        path="${rest%%$'\t'*}"
        local iconsrc="${rest#*$'\t'}"
        # A short, filesystem-safe handle for the command line.
        # Whole words only: cutting mid-word gave 'callofdutymodernwarfarei',
        # which nobody is going to type.
        local slug="" word
        for word in $(printf '%s' "$name" | tr -c '[:alnum:]' ' '); do
            word=$(printf '%s' "$word" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
            [ -n "$word" ] || continue
            [ ${#slug} -ge 16 ] && break
            slug="$slug$word"
        done
        [ -n "$slug" ] || slug="app$n"
        echo
        echo "  Adding '$name' as '$slug'..."
        cmd_add "$slug" "$path" --name "$name" --icon-from "$iconsrc"
    done
}

# The whole guest screen, as one window. For seeing what the VM is doing when
# nothing is matching - an installer waiting on a click, a dialog nobody
# streamed, a desktop that never finished logging in.
cmd_desktop() {
    APP_NAME="Vypr Desktop"; APP_ICON="vypr"
    local matches=("Vypr Desktop")

    ensure_region
    start_vm
    start_daemon matches
    start_agent
    start_parsec
    start_watcher

    local i
    for i in $(seq 1 24); do
        pgrep -x vypr-window >/dev/null && { say "The guest desktop is on screen."; return 0; }
        sleep 5
    done
    die "the desktop did not appear - check ${XDG_RUNTIME_DIR:-/tmp}/vyprd.log"
}

cmd_apps() {
    [ -d "$APPS" ] && ls -1 "$APPS"/*.conf 2>/dev/null | while read -r f; do
        printf '  %-16s %s\n' "$(basename "$f" .conf)" "$(sed -n 's/^NAME="\(.*\)"/\1/p' "$f")"
    done || echo "  no apps registered yet - add one with 'vypr add'"
}

cmd_status() {
    printf '  VM %-14s %s\n' "$VM" "$(virsh domstate "$VM" 2>/dev/null || echo missing)"
    printf '  vyprd          %s\n' "$(pgrep -x vyprd >/dev/null && echo running || echo stopped)"
    # pgrep -c prints 0 and *also* exits non-zero when nothing matches, so a
    # '|| echo 0' fallback appends a second count rather than supplying one.
    printf '  windows open   %s\n' "$(pgrep -xc vypr-window 2>/dev/null || true)"
    if [ -e "$SHM" ]; then
        printf '  region         %s (%s MiB)\n' "$SHM" "$(( $(stat -c%s "$SHM") / 1024 / 1024 ))"
    else
        printf '  region         missing\n'
    fi
}

# A health check for the parts that are easy to get wrong and quiet when they
# are: a region recreated empty by tmpfiles, a domain that lost its shmem device
# to an edit in virt-manager, a guest that is up but not answering.
cmd_doctor() {
    local want=$(( ${SHM_SIZE_MB:-$SHM_SIZE_MB_DEFAULT} * 1024 * 1024 ))
    local bad=0

    echo "region"
    if [ -e "$SHM" ]; then
        local size owner
        size=$(stat -c%s "$SHM"); owner=$(stat -c'%U:%G %a' "$SHM")
        printf '  %s  %s  %s MiB\n' "$SHM" "$owner" "$(( size / 1024 / 1024 ))"
        if [ "$size" -lt "$want" ]; then
            echo "  it is smaller than the configured $(( want / 1024 / 1024 )) MiB;"
            echo "  this is normal after a reboot and 'vypr run' fixes it"
        fi
    else
        echo "  MISSING - apply the tmpfiles rule the installer printed"
        bad=1
    fi

    echo "binaries"
    local b p
    for b in vyprd vypr-window; do
        p=$(command -v "$b" 2>/dev/null)
        if [ -n "$p" ]; then printf '  %-12s %s\n' "$b" "$p"
        else printf '  %-12s NOT ON PATH\n' "$b"; bad=1; fi
    done

    # A kernel that has been upgraded but not rebooted has no module tree for
    # the version actually running, so nothing that is not already loaded can
    # load. It presents as a controller that enumerates on USB, gets no driver,
    # creates no input device and is invisible to everything - which looks like
    # a fault in whatever you were trying to use it with. Cost an hour once.
    if [ ! -d "/lib/modules/$(uname -r)" ]; then
        echo "kernel"
        echo "  running $(uname -r), whose modules are not installed."
        echo "  The kernel was upgraded and this machine has not rebooted, so"
        echo "  drivers that are modules - controllers among them - cannot load."
        echo "  Reboot."
        bad=1
    fi

    echo "controllers"
    if [ -x "$BIN/vypr-window" ]; then
        "$BIN/vypr-window" --list-pads 2>/dev/null | sed 's/^/  /'
    fi

    echo "vm"
    local state; state=$(virsh domstate "$VM" 2>/dev/null || echo missing)
    printf '  %-12s %s\n' "$VM" "$state"
    if [ "$state" = "missing" ]; then
        echo "  that domain does not exist - check VM= in your config"
        bad=1
    else
        local xml; xml=$(virsh dumpxml --inactive "$VM" 2>/dev/null)
        grep -q "shmem name='vypr'" <<<"$xml" \
            && echo "  shmem device  present" \
            || { echo "  shmem device  MISSING - re-run install/install.sh"; bad=1; }
        grep -q topoext <<<"$xml" \
            && echo "  topoext       required" \
            || echo "  topoext       absent (the guest will not see SMT)"
        grep -q "type='tablet'" <<<"$xml" \
            && { echo "  usb tablet    PRESENT - this breaks the mouse in games"; bad=1; } \
            || echo "  usb tablet    absent, as it should be"
    fi

    echo "guest"
    if [ "$state" = "running" ]; then
        resolve_guest >/dev/null 2>&1 || true
        if guest 'echo ok' >/dev/null 2>&1; then
            echo "  ssh           answering"

            # The real requirement behind "capture is unavailable": DWM needs a
            # display to compose. A passed-through GPU with nothing plugged into
            # it has none, and no amount of Vypr fixes that.
            local disp
            # No $_ in here: it is expanded away by the shell layers between
            # this script and PowerShell, leaving a filter that matches nothing.
            disp=$(guest 'powershell -NoProfile -Command "@(Get-CimInstance Win32_VideoController | Where-Object CurrentHorizontalResolution -gt 0).Count"' 2>/dev/null | tr -d '\r' | tr -cd '0-9')
            if [ -n "$disp" ] && [ "$disp" -gt 0 ]; then
                echo "  display       $disp active"
            else
                echo "  display       NONE - nothing to capture. Attach a monitor or a"
                echo "                dummy plug to the passed-through GPU, or run"
                echo "                something that provides a virtual display."
                bad=1
            fi
            guest 'tasklist /fi "imagename eq vypr-agent.exe" /fo csv /nh' 2>/dev/null \
                | grep -q vypr-agent \
                && echo "  agent         running" \
                || echo "  agent         not running ('vypr up' starts it)"
        else
            echo "  ssh           NOT answering - check GUEST/GUEST_USER in your config"
            bad=1
        fi
    else
        echo "  not running, so nothing to ask"
    fi

    echo
    [ "$bad" -eq 0 ] && echo "Nothing here needs attention." \
                     || echo "Some of the above needs attention."
    return "$bad"
}

cmd_up()   { ensure_region; start_vm; start_agent; start_parsec; say "Session is up."; }
cmd_down() {
    pkill -x vypr-window 2>/dev/null
    pkill -x vyprd 2>/dev/null
    guest 'schtasks /end /tn vypr-agent' >/dev/null 2>&1
    if [ "${SHUTDOWN_VM_ON_EXIT:-1}" = "1" ]; then
        virsh shutdown "$VM" >/dev/null 2>&1
        say "Session stopped, and the VM is shutting down."
    else
        say "Session stopped. The VM is still running - 'virsh shutdown $VM' to stop it too."
    fi
}

case "${1:-}" in
    run)    shift; cmd_run "$@" ;;
    add)    shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    apps)   cmd_apps ;;
    --debug)
        shift
        case "${1:-}" in
            desktop) cmd_desktop ;;
            *) echo "vypr: --debug takes: desktop" >&2; exit 2 ;;
        esac
        ;;
    detect) cmd_detect ;;
    open)   shift; cmd_open "$@" ;;
    associate) shift; cmd_associate "$@" ;;
    __sync) shift; watch_and_sync "$@" ;;   # internal: carry saves back out
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    __watch) watch_and_shutdown ;;   # internal: the shutdown supervisor
    up)     cmd_up ;;
    down)   cmd_down ;;
    # The title plus every documented subcommand, wherever they sit in the
    # header - a fixed line range went stale each time one was added.
    *) sed -n '3p;/^#   vypr /p' "$0" | sed 's/^# \?//' ;;
esac
